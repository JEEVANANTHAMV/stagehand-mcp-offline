{
    "compilerOptions": {
        "target": "ES2020",
        "lib": [
            "ES2020"
        ],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "outDir": "./dist/backend",
        "rootDir": "./src/backend",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": true
    },
    "include": [
        "src/backend/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}