{
    "name": "innosynth-mcp-webapp",
    "version": "1.0.0",
    "description": "Modern web UI for Innosynth MCP Server with FRP tunnel management",
    "type": "module",
    "scripts": {
        "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
        "dev:backend": "tsx src/backend/index.ts",
        "dev:frontend": "vite",
        "build": "npm run build:backend && npm run build:frontend",
        "build:backend": "tsc -p tsconfig.backend.json",
        "build:frontend": "vite build",
        "preview": "vite preview",
        "start": "node dist/backend/index.js",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.13.1",
        "cors": "^2.8.5",
        "express": "^4.18.2",
        "react": "^18.2.0",
        "react-dom": "^18.2.2",
        "ws": "^8.14.2"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.4.2",
        "@testing-library/react": "^14.2.1",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "^20.10.0",
        "@types/react": "^18.2.45",
        "@types/react-dom": "^18.2.18",
        "@types/supertest": "^7.2.0",
        "@types/ws": "^8.5.10",
        "@vitejs/plugin-react": "^4.2.1",
        "@vitest/coverage-v8": "^1.3.1",
        "autoprefixer": "^10.4.16",
        "concurrently": "^8.2.2",
        "jsdom": "^24.0.0",
        "postcss": "^8.4.32",
        "supertest": "^6.3.3",
        "tailwindcss": "^3.4.0",
        "tsx": "^4.7.0",
        "typescript": "^5.3.3",
        "vite": "^5.0.0",
        "vitest": "^1.3.1"
    }
}
